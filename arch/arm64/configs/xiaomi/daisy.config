# CODEC drivers
CONFIG_SND_SOC_MAX98927=y

# Frame buffer hardware drivers
CONFIG_ENABLE_PM_TP_SUSPEND_RESUME=y

# Input Device Drivers
CONFIG_TOUCHSCREEN_GT917D_D1S=y
CONFIG_TOUCHSCREEN_FT5446_D1S=y
CONFIG_FINGERPRINT_FPC1020=y
CONFIG_FINGERPRINT_GOODIX_GF3208=y

# Kernel target level 5 -> 6
CONFIG_ANDROID_PARANOID_NETWORK=n
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_XCBC=y
CONFIG_SONY_FF=y
CONFIG_GKI_HIDDEN_GPU_CONFIGS=y
CONFIG_TRACE_GPU_MEM=y
CONFIG_XFRM_MIGRATE=y

# Platform
CONFIG_MACH_XIAOMI_DAISY=y

# Pseudo filesystems
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y
